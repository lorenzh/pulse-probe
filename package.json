{
  "name": "@lorenzh/pulse-probe",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Worker that runs checks (HTTP, TLS, TCP, DNS and domain expiry) and posts results to pulse-api.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#dc69a126bebbe50d8a7339ea1325d51b2ea43d7d",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#ebcbbb613328494185833f7133f1242910986948",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#236df214f9df8658f2992dd6f7c100952c07102b"
  }
}
