{
  "name": "@lorenzh/pulse-probe",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Worker that runs checks (HTTP, TLS, TCP, DNS and domain expiry) and posts results to pulse-api.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint . && pulse-workflows",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#04108fa0c67d9a79c0f6d1ade4dd78df3ad8a4a7",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#7ce23aaf3fa3e038f65ecfed755188b83bde143f",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#739188a87a177c0e8b5a8938e3f54c2bdaf19df4"
  }
}
